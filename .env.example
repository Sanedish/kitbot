# Required
DISCORD_TOKEN=

# Music jukebox (optional)
MUSIC_DIR=./music
MUSIC_EXCLUDE_DIRS=
MUSIC_DASH_HOST=127.0.0.1
MUSIC_DASH_PORT=8780
MUSIC_ADMIN_PASSWORD=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Broadcast processing loop, leave blank if unused
OMNIA_INPUT_URL=
ICECAST_PUSH_URL=
RAW_STREAM_PUBLIC_URL=

# Moderation dashboard (optional, also needs data/staff-access.json)
MOD_DASH_HOST=127.0.0.1
MOD_DASH_PORT=8781
MOD_DASH_SECRET=
# Overrides staff_guild_id from config.json
STAFF_SERVER=
# Public file uploads from the dashboard
UPLOAD_DIR=
UPLOAD_PUBLIC_URL=

# PocketBase staff accounts (optional, binary goes in pb/)
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Folding@home stats (optional)
FAH_USER=
FAH_TEAM=
FAH_PASSKEY=
FAH_EMAIL=
FAH_PASSWORD=
